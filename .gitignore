# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# salida de Playwright: capturas y reportes que se regeneran al correr
/e2e/capturas/
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env

# worker de pdf.js (lo copia scripts/copiar-worker-pdf.mjs en postinstall)
/public/pdf.worker.min.mjs

# Modelos y runtimes del reconocimiento facial, ~36 MB en disco (los
# prepara scripts/copiar-modelos-faciales.mjs en postinstall: copia
# MediaPipe y los pesos de dlib desde node_modules, y baja una vez el
# face_landmarker.task, que no viaja en npm).
/public/facial/
# Ubicación anterior. Se deja ignorada un tiempo para que un working tree
# viejo no la traiga de vuelta como archivo sin seguimiento.
/public/models/

# Artefactos locales del CLI de Supabase (rama activa, versión cacheada).
# No son del proyecto: los genera `supabase start` en cada máquina.
supabase/.branches/
supabase/.temp/
