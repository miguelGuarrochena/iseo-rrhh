  "description": "ISEO RH — gestión de RRHH para PyMEs",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "postinstall": "node scripts/copiar-worker-pdf.mjs && node scripts/copiar-modelos-faciales.mjs",
    "dev": "next dev",
