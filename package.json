    "@supabase/supabase-js": "^2.110.0",
    "@tabler/icons-react": "^2.44.0",
    "@vercel/analytics": "^2.0.1",
    "@vladmandic/face-api": "^1.7.15",
    "d3-org-chart": "^3.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^10.16.16",
    "next": "^14.2.35",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.2.0",
